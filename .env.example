REDIS_PASSWORD=redis_password

# Database
DB_DATABASE=spatialai
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Keycloak
KC_HOSTNAME=localhost
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URL=http://keycloak:8080/keycloak

# Application
APP_IMAGE=enerplanet:latest
APP_URL=http://localhost:3000
SERVER_URL=http://localhost:8000

# Backend internal lifecycle API. CALLBACK_SECRET must match the value in
# enerplanet/backend/.env — the webservice uses it to authenticate callbacks.
BACKEND_INTERNAL_URL=http://localhost:8000
CALLBACK_SECRET=changeme
