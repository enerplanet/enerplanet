# Copy to shared.env beside docker-compose.shared.yml and fill in. Every value
# without a default is required: the stack refuses to start rather than run on
# a placeholder.
#
#   cp shared.env.example shared.env
#
# These are the services every simulation domain uses, not heat alone. The
# heat images and databases live in heat.env. Both files are passed on every
# command.
#
# On the production target the deploy workflow seeds this file from here and
# fills the keys in from the repository secrets WEATHER_API_KEYS,
# WEATHER_API_KEY, TENTACRON_KEY_FRONTEND and TENTACRON_KEY_BATCH, and points
# WEATHER_DATA_HOST_DIR at the archive it copies. A value already in the file
# is kept, so a machine configured by hand is not overwritten.

# --- Image tags ------------------------------------------------------------
# 2.0.2 is the first weather release with an image; 2.0.1 built nothing.
WEATHER_IMAGE_TAG=2.0.2
TENTACRON_IMAGE_TAG=0.4.0-alpha

# --- weather ---------------------------------------------------------------
# Host directory holding <provider>/<country>/output/*.nc, mounted read-only.
# fixtures/load.sh lays the committed cuts out in exactly this shape.
WEATHER_DATA_HOST_DIR=./heat-data/weather
WEATHER_API_WORKERS=2
# Comma-separated. WEATHER_API_KEY below must be one of these, or TentaCron
# cannot call weather-serve.
WEATHER_API_KEYS=

# --- TentaCron -------------------------------------------------------------
# The config it runs. Build it from TentaCron's own environment/config.yaml,
# which is the file in service; enerplanet/tentacron.yaml has never been
# loaded and names hosts that do not resolve.
TENTACRON_CONFIG=./tentacron.prod.yaml

# Client keys. TENTACRON_KEY_FRONTEND must equal the backend's
# TENTACRON_API_KEY or every heat call is rejected.
TENTACRON_KEY_FRONTEND=
TENTACRON_KEY_BATCH=

# Credentials TentaCron injects into outbound calls. Nothing in this stack
# checks a credential except weather, so the rest exist only because the
# config interpolates them and an unset variable aborts startup. meme, pv1 and
# wind name targets this stack does not run.
WEATHER_API_KEY=
BUEM_API_KEY=unused
IGNIS_API_KEY=unused
MEME_API_KEY=unused
PV1_API_KEY=unused
WIND_API_KEY=unused
