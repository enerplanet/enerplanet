# Copy to heat.env beside docker-compose.heat.yml and fill in. Every value
# without a default is required: the stack refuses to start rather than run on
# a placeholder.
#
#   cp heat.env.example heat.env

# --- Image tags ------------------------------------------------------------
# Pinned, never `latest`. buem-model's `latest` moves on every push to its
# release branch, so following it would change production without a deploy.
C2T_IMAGE_TAG=0.6.0
IGNIS_IMAGE_TAG=0.6.0
BUEM_MODEL_IMAGE_TAG=6.3.0
BUEM_GATEWAY_IMAGE_TAG=6.2.0
# 2.0.2 is the first release with an image; 2.0.1 built nothing.
WEATHER_IMAGE_TAG=2.0.2
TENTACRON_IMAGE_TAG=0.4.0-alpha

# --- Databases -------------------------------------------------------------
# Internal to the stack; nothing publishes a port. Still worth generating
# rather than copying: openssl rand -hex 16
C2T_DB_USER=postgres
C2T_DB_PASSWORD=
C2T_DB_NAME=city2tabula
IGNIS_DB_USER=postgres
IGNIS_DB_PASSWORD=
IGNIS_DB_NAME=ignis

# --- weather ---------------------------------------------------------------
# Host directory holding <provider>/<country>/output/*.nc, mounted read-only.
# fixtures/load.sh lays the committed cuts out in exactly this shape.
WEATHER_DATA_HOST_DIR=./heat-data/weather
WEATHER_API_WORKERS=2
# Comma-separated. WEATHER_API_KEY below must be one of these, or TentaCron
# cannot call weather-serve.
WEATHER_API_KEYS=

# --- TentaCron -------------------------------------------------------------
# The config it runs. Build it from TentaCron's own environment/config.yaml,
# which is the file in service; enerplanet/tentacron.yaml has never been
# loaded and names hosts that do not resolve.
TENTACRON_CONFIG=./tentacron.prod.yaml

# Client keys. TENTACRON_KEY_FRONTEND must equal the backend's
# TENTACRON_API_KEY or every heat call is rejected.
TENTACRON_KEY_FRONTEND=
TENTACRON_KEY_BATCH=

# Credentials TentaCron injects into outbound calls. Nothing in this stack
# checks a credential except weather, so the rest exist only because the
# config interpolates them and an unset variable aborts startup.
WEATHER_API_KEY=
BUEM_API_KEY=unused
IGNIS_API_KEY=unused
MEME_API_KEY=unused
PV1_API_KEY=unused
WIND_API_KEY=unused

# --- Browser origins -------------------------------------------------------
# Only affects browser callers. The backend and TentaCron send no Origin
# header, so leaving this empty does not stop the platform working.
ALLOWED_ORIGINS=
