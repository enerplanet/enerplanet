# Copy to heat.env beside docker-compose.heat.yml and fill in. Every value
# without a default is required: the stack refuses to start rather than run on
# a placeholder.
#
#   cp heat.env.example heat.env
#
# The weather and TentaCron settings live in shared.env, because those
# services are not heat-specific. Both files are passed on every command.
#
# On the production target the deploy workflow seeds this file from here and
# fills the database passwords in from the repository secrets C2T_DB_PASSWORD
# and IGNIS_DB_PASSWORD. A value already in the file is kept, so a machine
# configured by hand is not overwritten.

# --- Image tags ------------------------------------------------------------
# Pinned, never `latest`. buem-model's `latest` moves on every push to its
# release branch, so following it would change production without a deploy.
C2T_IMAGE_TAG=0.6.0
IGNIS_IMAGE_TAG=0.6.0
BUEM_MODEL_IMAGE_TAG=6.3.0
BUEM_GATEWAY_IMAGE_TAG=6.2.0

# --- Databases -------------------------------------------------------------
# Internal to the stack; nothing publishes a port. Still worth generating
# rather than copying: openssl rand -hex 16
C2T_DB_USER=postgres
C2T_DB_PASSWORD=
C2T_DB_NAME=city2tabula
IGNIS_DB_USER=postgres
IGNIS_DB_PASSWORD=
IGNIS_DB_NAME=ignis

# --- Browser origins -------------------------------------------------------
# Read by ignis-http and buem-gateway. Only affects browser callers: the
# backend and TentaCron send no Origin header, so leaving this empty does not
# stop the platform working.
ALLOWED_ORIGINS=
