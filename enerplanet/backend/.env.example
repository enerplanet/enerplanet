# App Configuration
APP_NAME=Enerplanet
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_URL=http://host.docker.internal:8000
APP_TIMEZONE=Europe/Berlin

# Requests per minute per client IP. enerplanet/docker-compose.yml sets 1000 for
# the containerised backend; without this line a host run (make dev-bg) falls back
# to the 100 hardcoded in internal/middleware/rate_limit.go, which the configurator
# exhausts in a few building selections.
RATE_LIMIT_PER_MIN=1000

# Auth Service Configuration
AUTH_SERVICE_URL=http://localhost:8001

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=spatialai
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Session Configuration
SESSION_TTL_MINUTES=60
COOKIE_DOMAIN=localhost

# SMTP Configuration (for optional email sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=changeme
SMTP_FROM_NAME=Enerplanet
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=redis_password
REDIS_DATABASE=0

# Downstream Microservices
WEBSERVICE_SERVICE_URL=http://localhost:8089
PYLOVO_SERVICE_URL=http://localhost:8086
# TentaCron orchestrator: the server-side ignis, weather-serve, City2TABULA and buem-gateway calls (resolve endpoint, run_buem, enrich) route through it.
TENTACRON_SERVICE_URL=http://localhost:8400
TENTACRON_API_KEY=dev-frontend-key
# Weather archive requested from weather-serve. MERRA-2 is the only provider whose
# committed fixtures include the p10/p50/p90 scenarios models run on by default.
WEATHER_PROVIDER=merra-2
# BuEM release the stored results are keyed for; must equal BUEM_MODEL_IMAGE_TAG in
# repos.conf (make dev sets it from there). Results reporting another version are not stored.
BUEM_VERSION=6.10.0
# PV service (pv-simulate) release the stored PV profiles are keyed for; must equal
# PV_SERVICE_REF in repos.conf (make dev sets it from there). Unset, no PV is stored.
PV_VERSION=5c1959b207b86876b618399050994f85d9475624
OPENTECH_DB_SERVICE_URL=https://otdb.th-deg.de

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080/keycloak
KEYCLOAK_REALM=spatialhub
KEYCLOAK_CLIENT_ID=spatialhub
REDIRECT_URL=http://localhost:3000/callback-auth
# Callback authentication (shared secret for webservice callbacks)
# Generate with: openssl rand -hex 32
# Must match CALLBACK_SECRET in the simulation-engine docker-compose/.env
CALLBACK_SECRET=changeme

KEYCLOAK_CLIENT_SECRET=

# Toolbox authentication settings
KEYCLOAK_API_ISSUER=
KEYCLOAK_API_AUDIENCE=
KEYCLOAK_API_CLIENT_ID=
# Optional JWKS endpoint
KEYCLOAK_API_JWKS_URL=
# JWKS cache seconds
KEYCLOAK_API_JWKS_TTL_SECONDS=300
# Max token lifetime
KEYCLOAK_API_MAX_TOKEN_LIFETIME_SECONDS=900

# Frontend runtime configuration — served to the browser at /config.js.
# The image is environment-agnostic: set these at deploy time per environment.
# Each falls back to an existing var when unset (APP_URL, KEYCLOAK_*,
# APP_ENV), so only the overrides you need are required.
FRONTEND_SSO_ENABLED=false
#FRONTEND_KEYCLOAK_URL=http://localhost:8080/keycloak   # default: <APP_URL>/keycloak
#FRONTEND_KEYCLOAK_REALM=spatialhub                      # default: KEYCLOAK_REALM
#FRONTEND_KEYCLOAK_CLIENT_ID=spatialhub                  # default: KEYCLOAK_CLIENT_ID
#FRONTEND_KEYCLOAK_IDP_HINT=renvolveit                   # default: renvolveit
#FRONTEND_KEYCLOAK_REDIRECT_URI=http://localhost:3000/app/map  # default: <APP_URL>/app/map
#FRONTEND_API_BASE_URL=/api                              # default: /api
#FRONTEND_CARTO_BASEMAP_API_KEY=                         # default: empty
