{
  "name": "@model-builder/example-auto",
  "version": "0.0.0",
  "private": true,
  "description": "The Model Builder auto-node example module — the template for a node that runs itself. Self-contained workspace: cd here, npm install, npm test.",
  "type": "module",
  "main": "./index.tsx",
  "types": "./index.tsx",
  "exports": {
    ".": "./index.tsx"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@model-builder/core": "file:../../core",
    "@spatialhub/i18n": "file:../../../../../../../libs/i18n"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.8",
    "typescript": "~5.8.3",
    "vitest": "^4.0.14"
  }
}
